{
  "name": "coverly",
  "version": "1.0.0",
  "description": "Coverly",
  "author": "Coverly",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.coverly.app",
    "productName": "Coverly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Coverly-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}